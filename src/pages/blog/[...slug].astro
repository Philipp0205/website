---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../../lib/posts';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    // Slug keeps the file casing, e.g. "2025/KW2".
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description || undefined} type="article" nav="blog">
  <article class="container-narrow">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </span>
        {
          post.data.tags.length > 0 && (
            <span>
              {post.data.tags.map((tag) => (
                <a class="tag" href={url(`/tags/${tag}/`)}>{tag}</a>
              ))}
            </span>
          )
        }
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <div class="post-footer">
      <a href={url('/')} class="btn btn-outline">← Zurück zum Blog</a>
      <a href={url('/archive/')}>Alle Beiträge →</a>
    </div>
  </article>
</BaseLayout>
