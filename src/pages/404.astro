---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Seite nicht gefunden" noindex>
  <div class="container-narrow text-center">
    <header class="page-header">
      <h1>404</h1>
      <p class="description">Diese Seite gibt es nicht.</p>
    </header>
    <p><a href={url('/')} class="btn btn-outline">← Zurück zum Blog</a></p>
  </div>
</BaseLayout>
