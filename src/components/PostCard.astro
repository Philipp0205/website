---
import { url } from '../lib/url';
import { postPath, formatDate } from '../lib/posts';
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="post-card">
  <div class="post-meta">
    <span class="post-date">
      <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM7 11h5v5H7z"></path></svg>
      {formatDate(post.data.date)}
    </span>
    {
      post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <a class="tag" href={url(`/tags/${tag}/`)}>{tag}</a>
          ))}
        </div>
      )
    }
  </div>
  <h2><a href={url(postPath(post))}>{post.data.title}</a></h2>
  {post.data.description && <p class="post-excerpt">{post.data.description}</p>}
  <a href={url(postPath(post))} class="read-more">
    Weiterlesen: {post.data.title}
    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path></svg>
  </a>
</article>
